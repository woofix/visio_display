set -eu

ROOT_DIR="$(git rev-parse --show-toplevel)"
VERSION_FILE="$ROOT_DIR/VERSION"
BUMP_KIND="${VISIO_VERSION_BUMP:-auto}"

staged_names="$(git -C "$ROOT_DIR" diff --cached --name-only --diff-filter=ACMRT)"

blocked_media="$(printf '%s\n' "$staged_names" | grep -Ei '(^|/)(media|data|private)/|^web/static/data/|^web/data/private/|\.(avif|avi|gif|jpe?g|mkv|mov|mp4|png|webm|webp)$' || true)"

if [ -n "$blocked_media" ]; then
    echo "pre-commit: fichiers media/runtime interdits dans Git:" >&2
    printf '%s\n' "$blocked_media" >&2
    echo "pre-commit: retirez-les de l'index avec git rm --cached <fichier> ou gardez-les non suivis." >&2
    exit 1
fi

detect_bump_kind() {
    deleted_names="$(git -C "$ROOT_DIR" diff --cached --name-only --diff-filter=D)"

    if [ -n "$deleted_names" ]; then
        printf '%s\n' "major"
        return
    fi

    if printf '%s\n' "$changed_names" | grep -Eq '^(web/db\.py|docker-compose\.yml|Dockerfile|web/requirements(-dev)?\.txt)$'; then
        printf '%s\n' "major"
        return
    fi

    printf '%s\n' "patch"
}

case "$BUMP_KIND" in
    none|skip)
        exit 0
        ;;
    auto)
        BUMP_KIND="$(detect_bump_kind)"
        ;;
    major|minor|patch)
        ;;
    *)
        echo "pre-commit: VISIO_VERSION_BUMP doit valoir auto, major, minor, patch ou none." >&2
        exit 1
        ;;
esac

if [ ! -f "$VERSION_FILE" ]; then
    echo "pre-commit: fichier VERSION introuvable." >&2
    exit 1
fi

if ! git -C "$ROOT_DIR" diff --cached --quiet -- VERSION; then
    echo "pre-commit: VERSION est déjà préparé, incrément automatique ignoré."
    exit 0
fi

if ! git -C "$ROOT_DIR" diff --quiet -- VERSION; then
    echo "pre-commit: VERSION contient des changements non préparés." >&2
    echo "pre-commit: préparez-les avec git add VERSION ou annulez-les avant de recommitter." >&2
    exit 1
fi

current_version="$(tr -d '[:space:]' < "$VERSION_FILE")"

IFS=.
set -- $current_version
IFS=' '

if [ "$#" -ne 3 ]; then
    echo "pre-commit: VERSION doit utiliser le format numérique MAJOR.MINOR.PATCH, reçu: $current_version" >&2
    exit 1
fi

major="${1:-}"
minor="${2:-}"
patch="${3:-}"

case "$major:$minor:$patch" in
    *[!0123456789:]*|::*|*::|*:|:*)
        echo "pre-commit: VERSION doit utiliser le format numérique MAJOR.MINOR.PATCH, reçu: $current_version" >&2
        exit 1
        ;;
esac

case "$BUMP_KIND" in
    major)
        major=$((major + 1))
        minor=0
        patch=0
        ;;
    minor)
        minor=$((minor + 1))
        patch=0
        ;;
    patch)
        patch=$((patch + 1))
        ;;
esac

new_version="$major.$minor.$patch"

echo "pre-commit: version actuelle: $current_version"
echo "pre-commit: version proposée: $new_version"
echo "pre-commit: type détecté: $BUMP_KIND"

if [ -t 0 ]; then
    printf "Valider la version ? [Y/n/e=éditer] : "
    read -r answer

    case "$answer" in
        ""|y|Y)
            final_version="$new_version"
            ;;
        e|E)
            printf "Entrer la version voulue (MAJOR.MINOR.PATCH) : "
            read -r manual_version

            if ! printf '%s' "$manual_version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
                echo "pre-commit: version invalide: $manual_version" >&2
                exit 1
            fi

            final_version="$manual_version"
            ;;
        n|N)
            echo "pre-commit: commit annulé."
            exit 1
            ;;
        *)
            echo "pre-commit: réponse invalide."
            exit 1
            ;;
    esac
else
    final_version="$new_version"
fi

printf '%s\n' "$final_version" > "$VERSION_FILE"
git -C "$ROOT_DIR" add VERSION

echo "pre-commit: version $current_version -> $final_version"
